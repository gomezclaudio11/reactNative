{
  "name": "rate-repository-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint ./src/**/*.{js,jsx} App.js --no-error-on-unmatched-pattern"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-router-native)"
    ]
  },
  "dependencies": {
    "@apollo/client": "3.8.8",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-picker/picker": "2.11.1",
    "dotenv": "^17.4.2",
    "expo": "54.0.34",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.12",
    "expo-status-bar": "~3.0.9",
    "formik": "^2.4.9",
    "graphql": "15.8.0",
    "hoist-non-react-statics": "^3.3.2",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "lodash": "^4.17.23",
    "lodash.clonedeep": "^4.5.0",
    "lodash.isplainobject": "^4.0.6",
    "lodash.topath": "^4.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "react-router-native": "^6.30.3",
    "rxjs": "^7.8.2",
    "use-debounce": "^10.1.1",
    "yup": "^1.7.1"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "babel-eslint": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-react": "^7.37.5"
  }
}
